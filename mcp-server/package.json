{
  "name": "jsdesign-mcp-server",
  "version": "0.2.1",
  "description": "MCP server that bridges Instant Design (js.design) plugin to Cursor/Claude for design-to-code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jsdesign-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "daemon": "node dist/index.js daemon",
    "dev": "tsc && node dist/index.js",
    "dev:daemon": "tsc && node dist/index.js daemon",
    "release": "node scripts/publish.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jsdesign",
    "instant-design",
    "cursor",
    "design-to-code"
  ],
  "author": "nothing-sy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nothing-sy/js.design.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/nothing-sy/js.design#readme",
  "bugs": {
    "url": "https://github.com/nothing-sy/js.design/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
